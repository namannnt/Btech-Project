# Environment Configuration for NL2SQL Multi-Agent System

# API Keys
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here  # Optional fallback LLM

# Database Configuration
DATABASE_URL=sqlite:///./data/sample.db

# Application Settings
APP_NAME="NL2SQL Multi-Agent System"
DEBUG=true
LOG_LEVEL=INFO

# Vector Store (ChromaDB)
CHROMA_PERSIST_DIR=./data/chromadb

# Query Limits
MAX_ROW_LIMIT=1000
QUERY_TIMEOUT_SECONDS=30
