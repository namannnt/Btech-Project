# Environment Configuration for NL2SQL 8-Agent System
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control — it is in .gitignore.

# =============================================================================
# LLM API Keys (at least one required)
# =============================================================================
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# =============================================================================
# Database Connection
# =============================================================================
# SQLite (default — no setup required):
SQLITE_URL=sqlite:///./data/sample.db

# PostgreSQL (set to override SQLite):
POSTGRES_URL=

# MySQL (set to override SQLite):
MYSQL_URL=

# Legacy single-URL override (takes highest priority if set):
# DATABASE_URL=sqlite:///./data/sample.db

# =============================================================================
# Vector Store (ChromaDB) — for Schema Retrieval Agent
# =============================================================================
CHROMA_PERSIST_DIR=./data/chroma_db
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# =============================================================================
# LLM Model Selection
# =============================================================================
PRIMARY_LLM_MODEL=gpt-4o-mini
FALLBACK_LLM_MODEL=llama-3.1-70b-versatile
EXPLANATION_LLM_MODEL=llama-3.1-8b-instant

# =============================================================================
# Query Execution Safety Limits
# =============================================================================
MAX_QUERY_TIMEOUT=30
MAX_ROWS_RETURNED=1000

# =============================================================================
# Security & Permissions
# =============================================================================
DEFAULT_ROLE=user
SECRET_KEY=change-me-in-production

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME=NL2SQL Multi-Agent System
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO
